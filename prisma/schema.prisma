// Career OS — Prisma Schema
// Covers all 5 pillars: Profile Intelligence, Opportunity Engine,
// Pipeline/Applications, Personal Brand Engine, Growth Loop

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// PILLAR 1 — PROFILE INTELLIGENCE
// ─────────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  name              String?
  email             String?  @unique
  image             String?
  headline          String?  // "CPO & Co-founder | Growth | VC-backed"
  summary           String?  // 2–3 line bio
  location          String?
  linkedinUrl       String?
  githubUrl         String?
  websiteUrl        String?
  targetRoles       String?  // JSON array: ["CPO","VP Product","Co-founder"]
  targetIndustries  String?  // JSON array
  targetSalaryMin   Int?
  targetSalaryMax   Int?
  openToRemote      Boolean  @default(true)
  openToRelocation  Boolean  @default(false)
  profileScore      Int      @default(0) // 0–100 live score
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  experiences       Experience[]
  educations        Education[]
  skills            Skill[]
  achievements      Achievement[]
  opportunities     Opportunity[]
  applications      Application[]
  brandPosts        BrandPost[]
  growthTasks       GrowthTask[]
  connections       Connection[]
  settings          Settings?

  @@map("users")
}

model Experience {
  id          String    @id @default(cuid())
  userId      String
  company     String
  title       String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  location    String?
  companySize String?   // "1–10", "11–50", "51–200", "201–1000", "1000+"
  companyType String?   // "startup", "scaleup", "enterprise", "vc", "consulting"
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements Achievement[]

  @@map("experiences")
}

model Education {
  id          String    @id @default(cuid())
  userId      String
  institution String
  degree      String?
  field       String?
  startYear   Int?
  endYear     Int?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("educations")
}

model Skill {
  id         String   @id @default(cuid())
  userId     String
  name       String
  category   String   // "product", "growth", "technical", "leadership", "domain", "tool"
  level      String   @default("intermediate") // "learning", "intermediate", "advanced", "expert"
  yearsExp   Float?
  inDemand   Boolean  @default(false) // flagged by market analysis
  isGap      Boolean  @default(false) // flagged as a gap vs target roles
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model Achievement {
  id           String     @id @default(cuid())
  userId       String
  experienceId String?
  title        String
  description  String
  metric       String?    // "Grew revenue 3x to $12M ARR"
  impact       String?    // "company", "team", "product", "market"
  category     String?    // "revenue", "growth", "product", "leadership", "fundraising"
  year         Int?
  isPublic     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience   Experience? @relation(fields: [experienceId], references: [id])

  @@map("achievements")
}

// ─────────────────────────────────────────────
// PILLAR 2 — OPPORTUNITY ENGINE
// ─────────────────────────────────────────────

model Opportunity {
  id               String    @id @default(cuid())
  userId           String
  title            String
  company          String
  companySize      String?
  companyStage     String?   // "seed", "series-a", "series-b", "growth", "public", "pe"
  companyWebsite   String?
  location         String?
  isRemote         Boolean   @default(false)
  salaryMin        Int?
  salaryMax        Int?
  equityMin        Float?    // percentage
  equityMax        Float?
  description      String?
  requirements     String?
  sourceUrl        String?
  sourcePlatform   String?   // "wellfound", "linkedin", "hacker-news", "exec-search", "vc-portfolio", "direct"
  roleType         String?   // "cpo", "vp-product", "gm", "coo", "cmo", "co-founder", "consulting"
  aiMatchScore     Int?      // 0–100
  aiMatchReason    String?   // LLM explanation
  aiSalaryEst      Int?      // estimated if not listed
  status           String    @default("new") // "new", "saved", "dismissed", "applied"
  discoveredAt     DateTime  @default(now())
  expiresAt        DateTime?
  isActive         Boolean   @default(true)

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  application      Application?

  @@map("opportunities")
}

// ─────────────────────────────────────────────
// PILLAR 3 — PIPELINE / APPLICATIONS
// ─────────────────────────────────────────────

model Application {
  id                String      @id @default(cuid())
  userId            String
  opportunityId     String      @unique
  stage             String      @default("discovered")
  // stages: discovered → applied → screen → interview_1 → interview_2 → final → offer → closed_won → closed_lost
  appliedAt         DateTime?
  resumeUsed        String?     // JSON snapshot of resume used
  coverLetter       String?
  notes             String?
  nextActionDate    DateTime?
  nextActionNote    String?
  offerAmount       Int?
  offerEquity       Float?
  rejectionReason   String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id])
  events            ApplicationEvent[]
  contacts          ApplicationContact[]

  @@map("applications")
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  type          String      // "stage_change", "note", "email_sent", "call", "interview"
  fromStage     String?
  toStage       String?
  note          String?
  occurredAt    DateTime    @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_events")
}

model ApplicationContact {
  id            String      @id @default(cuid())
  applicationId String
  name          String
  title         String?
  email         String?
  linkedinUrl   String?
  role          String?     // "hiring-manager", "recruiter", "champion", "interviewer"
  notes         String?

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_contacts")
}

// ─────────────────────────────────────────────
// PILLAR 4 — PERSONAL BRAND ENGINE
// ─────────────────────────────────────────────

model BrandPost {
  id             String    @id @default(cuid())
  userId         String
  platform       String    // "linkedin", "twitter", "substack", "medium", "blog"
  contentType    String    // "thought-leadership", "win", "insight", "story", "thread"
  topic          String?
  draft          String    // AI-generated draft
  finalContent   String?   // edited & published version
  status         String    @default("draft") // "draft", "scheduled", "published"
  publishedAt    DateTime?
  scheduledFor   DateTime?
  sourceAchievement String? // which achievement inspired this
  engagementData String?   // JSON: {likes, comments, shares, impressions}
  aiPromptUsed   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brand_posts")
}

model Connection {
  id             String    @id @default(cuid())
  userId         String
  name           String
  title          String?
  company        String?
  linkedinUrl    String?
  email          String?
  relationship   String?   // "strong", "warm", "cold", "target"
  canIntroTo     String?   // JSON array of companies/roles they can intro to
  lastContactedAt DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("connections")
}

model BrandMetric {
  id                  String   @id @default(cuid())
  userId              String
  date                DateTime @default(now())
  platform            String
  followers           Int?
  postCount           Int?
  avgEngagementRate   Float?
  profileViews        Int?
  searchAppearances   Int?

  @@map("brand_metrics")
}

// ─────────────────────────────────────────────
// PILLAR 5 — GROWTH LOOP
// ─────────────────────────────────────────────

model GrowthTask {
  id           String    @id @default(cuid())
  userId       String
  category     String    // "skill", "credential", "project", "content", "network", "application"
  title        String
  description  String?
  priority     String    @default("medium") // "high", "medium", "low"
  status       String    @default("todo")   // "todo", "in_progress", "done", "skipped"
  dueDate      DateTime?
  completedAt  DateTime?
  relatedSkill String?   // skill gap this addresses
  relatedRole  String?   // target role this helps with
  estimatedHours Float?
  resourceUrl  String?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("growth_tasks")
}

model MarketInsight {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  category    String   // "salary", "skill-demand", "role-trend", "industry"
  title       String
  body        String
  source      String?
  roleType    String?  // which role type this applies to
  isActive    Boolean  @default(true)

  @@map("market_insights")
}

model WeeklyDigest {
  id              String   @id @default(cuid())
  userId          String
  weekOf          DateTime
  topMatches      String   // JSON array of opportunity IDs
  growthTask      String?  // suggested task
  marketInsight   String?
  profileScore    Int?
  emailSentAt     DateTime?
  createdAt       DateTime @default(now())

  @@map("weekly_digests")
}

// ─────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────

model Settings {
  id                  String  @id @default(cuid())
  userId              String  @unique
  openaiApiKey        String?
  linkedinToken       String?
  githubToken         String?
  emailNotifications  Boolean @default(true)
  weeklyDigestEmail   String?
  digestDayOfWeek     Int     @default(1) // 0=Sun, 1=Mon...
  autoApply           Boolean @default(false)
  autoGenerateContent Boolean @default(true)
  theme               String  @default("dark")

  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}
