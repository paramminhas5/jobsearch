// Career OS — Prisma Schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// PILLAR 1 — PROFILE INTELLIGENCE
// ─────────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  name              String?
  email             String?  @unique
  image             String?
  headline          String?
  summary           String?
  location          String?
  linkedinUrl       String?
  githubUrl         String?
  websiteUrl        String?
  targetRoles       String?
  targetIndustries  String?
  targetSalaryMin   Int?
  targetSalaryMax   Int?
  openToRemote      Boolean  @default(true)
  openToRelocation  Boolean  @default(false)
  profileScore      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  experiences  Experience[]
  educations   Education[]
  skills       Skill[]
  achievements Achievement[]
  opportunities Opportunity[]
  applications Application[]
  brandPosts   BrandPost[]
  growthTasks  GrowthTask[]
  connections  Connection[]
  settings     Settings?

  @@map("users")
}

model Experience {
  id          String    @id @default(cuid())
  userId      String
  company     String
  title       String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  location    String?
  companySize String?
  companyType String?
  createdAt   DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements Achievement[]

  @@map("experiences")
}

model Education {
  id          String   @id @default(cuid())
  userId      String
  institution String
  degree      String?
  field       String?
  startYear   Int?
  endYear     Int?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("educations")
}

model Skill {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String
  level     String   @default("intermediate")
  yearsExp  Float?
  inDemand  Boolean  @default(false)
  isGap     Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model Achievement {
  id           String   @id @default(cuid())
  userId       String
  experienceId String?
  title        String
  description  String
  metric       String?
  impact       String?
  category     String?
  year         Int?
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience Experience? @relation(fields: [experienceId], references: [id])

  @@map("achievements")
}

// ─────────────────────────────────────────────
// PILLAR 2 — OPPORTUNITY ENGINE
// ─────────────────────────────────────────────

model Opportunity {
  id             String    @id @default(cuid())
  userId         String
  title          String
  company        String
  companySize    String?
  companyStage   String?
  companyWebsite String?
  location       String?
  isRemote       Boolean   @default(false)
  salaryMin      Int?
  salaryMax      Int?
  equityMin      Float?
  equityMax      Float?
  description    String?
  requirements   String?
  sourceUrl      String?
  sourcePlatform String?
  roleType       String?
  aiMatchScore   Int?
  aiMatchReason  String?
  aiSalaryEst    Int?
  status         String    @default("new")
  discoveredAt   DateTime  @default(now())
  expiresAt      DateTime?
  isActive       Boolean   @default(true)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application?

  @@map("opportunities")
}

// ─────────────────────────────────────────────
// PILLAR 3 — PIPELINE / APPLICATIONS
// ─────────────────────────────────────────────

model Application {
  id              String    @id @default(cuid())
  userId          String
  opportunityId   String    @unique
  stage           String    @default("discovered")
  appliedAt       DateTime?
  resumeUsed      String?
  coverLetter     String?
  notes           String?
  nextActionDate  DateTime?
  nextActionNote  String?
  offerAmount     Int?
  offerEquity     Float?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity        @relation(fields: [opportunityId], references: [id])
  events      ApplicationEvent[]
  contacts    ApplicationContact[]

  @@map("applications")
}

model ApplicationEvent {
  id            String   @id @default(cuid())
  applicationId String
  type          String
  fromStage     String?
  toStage       String?
  note          String?
  occurredAt    DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_events")
}

model ApplicationContact {
  id            String  @id @default(cuid())
  applicationId String
  name          String
  title         String?
  email         String?
  linkedinUrl   String?
  role          String?
  notes         String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_contacts")
}

// ─────────────────────────────────────────────
// PILLAR 4 — PERSONAL BRAND ENGINE
// ─────────────────────────────────────────────

model BrandPost {
  id                String    @id @default(cuid())
  userId            String
  platform          String
  contentType       String
  topic             String?
  draft             String
  finalContent      String?
  status            String    @default("draft")
  publishedAt       DateTime?
  scheduledFor      DateTime?
  sourceAchievement String?
  engagementData    String?
  aiPromptUsed      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brand_posts")
}

model Connection {
  id              String    @id @default(cuid())
  userId          String
  name            String
  title           String?
  company         String?
  linkedinUrl     String?
  email           String?
  relationship    String?
  canIntroTo      String?
  lastContactedAt DateTime?
  notes           String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("connections")
}

model BrandMetric {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime @default(now())
  platform          String
  followers         Int?
  postCount         Int?
  avgEngagementRate Float?
  profileViews      Int?
  searchAppearances Int?

  @@map("brand_metrics")
}

// ─────────────────────────────────────────────
// PILLAR 5 — GROWTH LOOP
// ─────────────────────────────────────────────

model GrowthTask {
  id             String    @id @default(cuid())
  userId         String
  category       String
  title          String
  description    String?
  priority       String    @default("medium")
  status         String    @default("todo")
  dueDate        DateTime?
  completedAt    DateTime?
  relatedSkill   String?
  relatedRole    String?
  estimatedHours Float?
  resourceUrl    String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("growth_tasks")
}

model MarketInsight {
  id       String   @id @default(cuid())
  date     DateTime @default(now())
  category String
  title    String
  body     String
  source   String?
  roleType String?
  isActive Boolean  @default(true)

  @@map("market_insights")
}

model WeeklyDigest {
  id            String    @id @default(cuid())
  userId        String
  weekOf        DateTime
  topMatches    String
  growthTask    String?
  marketInsight String?
  profileScore  Int?
  emailSentAt   DateTime?
  createdAt     DateTime  @default(now())

  @@map("weekly_digests")
}

// ─────────────────────────────────────────────
// RECRUITER INTELLIGENCE
// ─────────────────────────────────────────────

model Recruiter {
  id              String    @id @default(cuid())
  name            String
  title           String?
  firm            String
  firmType        String
  tier            String    @default("a")
  rolesFocus      String
  stagesFocus     String
  industriesFocus String
  geoFocus        String
  email           String?
  linkedinUrl     String?
  twitterUrl      String?
  website         String?
  firmWebsite     String?
  approachMethod  String
  approachScript  String
  insiderNote     String?
  status          String    @default("not-contacted")
  lastContactedAt DateTime?
  nextFollowUp    DateTime?
  notes           String?
  rating          Int?
  isActive        Boolean   @default(true)
  placedRoles     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  outreaches RecruiterOutreach[]

  @@map("recruiters")
}

model RecruiterOutreach {
  id          String    @id @default(cuid())
  recruiterId String
  userId      String
  channel     String
  message     String
  sentAt      DateTime?
  repliedAt   DateTime?
  outcome     String?
  notes       String?
  createdAt   DateTime  @default(now())

  recruiter Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@map("recruiter_outreaches")
}

// ─────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────

model Settings {
  id                  String  @id @default(cuid())
  userId              String  @unique
  openaiApiKey        String?
  linkedinToken       String?
  githubToken         String?
  emailNotifications  Boolean @default(true)
  weeklyDigestEmail   String?
  digestDayOfWeek     Int     @default(1)
  autoApply           Boolean @default(false)
  autoGenerateContent Boolean @default(true)
  theme               String  @default("dark")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}
